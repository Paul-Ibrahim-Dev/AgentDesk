# Supabase (Project Settings > API) — safe to expose in the browser,
# RLS is what actually protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AgentDesk backend API
VITE_API_BASE_URL=http://localhost:4000

# Optional: id of the seeded "Elite Cuts Minna" demo business, to enable
# the public /demo page. Get this from `select id from businesses where
# slug = 'elite-cuts-minna';` after running database/seed/seed_demo_business.sql
VITE_DEMO_BUSINESS_ID=
